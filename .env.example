# Copy to `.env` and fill in. `.env` is gitignored.
#
# Base URL of the deployed IKEA rotera CORS proxy (Cloudflare Worker in
# tools/ikea-proxy/). The app loads furniture GLBs on the fly from `${VITE_IKEA_PROXY}/<article>`.
# Leave unset to fall back to dimensioned placeholder boxes (no models fetched).
VITE_IKEA_PROXY=https://ikea-rotera-proxy.YOUR-SUBDOMAIN.workers.dev
